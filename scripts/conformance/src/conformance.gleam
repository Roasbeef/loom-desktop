//// Projects recorded session traces with Loom's own `session_view`, as a second oracle.
////
//// `traces.gleam` (generated by scripts/conformance.sh from the committed traces) holds each
//// trace's frames as strings in the order the lane saw them. This module runs the received
//// snapshot frames through the same transfer decoder the terminal uses, accumulating the window
//// across catch-up cuts as the terminal does, then draws the strand's transcript with
//// `transcript.project`, and prints the lines of each trace as one JSON object. The desktop
//// core's own projection must produce the same user and assistant text.

import conformance/traces
import core/json
import gleam/io
import gleam/list
import gleam/option.{type Option, None, Some}
import gleam/result
import gleam/string
import session_view/snapshot
import session_view/snapshot_view
import session_view/transcript
import session_view/transcript_line

type State {
  State(
    expected: Option(snapshot.Expected),
    previous: Option(snapshot.Attachment),
    window: snapshot.Window,
    transfer: Option(snapshot.Transfer),
    from_seq: Int,
    captured: Option(snapshot.Captured),
  )
}

pub fn main() {
  let objects =
    traces.traces
    |> list.map(fn(trace) {
      let #(name, frames) = trace
      "\"" <> name <> "\": " <> project(frames)
    })
  io.println("{" <> string.join(objects, ",\n") <> "}")
}

fn project(frames: List(#(String, String))) -> String {
  let state =
    list.fold(
      frames,
      State(None, None, snapshot.empty(), None, 0, None),
      step,
    )
  case state.captured {
    None -> "{\"error\": \"no cut was completed\"}"
    Some(captured) ->
      case snapshot_view.decode(captured) {
        Error(reason) -> "{\"error\": " <> quote(reason) <> "}"
        Ok(view) -> {
          let lines = transcript.project(captured, view, "main")
          "{\"lines\": ["
          <> string.join(list.map(lines, line), ",")
          <> "]}"
        }
      }
  }
}

fn line(value: transcript_line.Line) -> String {
  "{\"speaker\": \"" <> speaker(value.speaker) <> "\", \"text\": " <> quote(value.text) <> "}"
}

fn speaker(value: transcript_line.Speaker) -> String {
  case value {
    transcript_line.User -> "user"
    transcript_line.Assistant -> "assistant"
    transcript_line.Reasoning -> "reasoning"
    _ -> "other"
  }
}

fn quote(text: String) -> String {
  json.to_string(json.String(text))
}

fn field(fields: List(#(String, json.JsonValue)), key: String) {
  list.key_find(fields, key)
}

fn step(state: State, frame: #(String, String)) -> State {
  let #(direction, text) = frame
  case json.parse(text) {
    Error(_) -> state
    Ok(json.Object(fields)) -> {
      case direction {
        "tx" -> sent(state, fields)
        _ -> received(state, fields)
      }
    }
    Ok(_) -> state
  }
}

// A catch-up names the sequence the next cut starts from. The first cut starts from the beginning.
fn sent(state: State, fields) -> State {
  case field(fields, "cmd"), field(fields, "body") {
    Ok(json.String("catch_up")), Ok(json.Object(body)) ->
      case field(body, "from_seq") {
        Ok(json.Int(from)) -> State(..state, from_seq: from)
        _ -> state
      }
    _, _ -> state
  }
}

fn received(state: State, fields) -> State {
  case field(fields, "event"), field(fields, "body") {
    Ok(json.String("snapshot_begin")), Ok(body) -> {
      let expected = case state.expected {
        Some(known) -> known
        None -> expected_from(body)
      }
      case
        snapshot.begin(
          body,
          expected,
          state.previous,
          state.window,
          state.from_seq,
        )
      {
        Ok(transfer) ->
          State(..state, expected: Some(expected), transfer: Some(transfer))
        Error(_) -> State(..state, transfer: None)
      }
    }
    Ok(json.String("snapshot_chunk")), Ok(body) ->
      case state.transfer {
        Some(transfer) ->
          case snapshot.chunk(transfer, body) {
            Ok(next) -> State(..state, transfer: Some(next))
            Error(_) -> State(..state, transfer: None)
          }
        None -> state
      }
    Ok(json.String("snapshot_end")), Ok(body) ->
      case state.transfer {
        Some(transfer) ->
          case snapshot.finish(transfer, body) {
            Ok(captured) ->
              State(
                ..state,
                previous: Some(captured.attachment),
                window: captured.window,
                transfer: None,
                captured: Some(captured),
              )
            Error(_) -> State(..state, transfer: None)
          }
        None -> state
      }
    _, _ -> state
  }
}

fn expected_from(body: json.JsonValue) -> snapshot.Expected {
  let get = fn(key) {
    case body {
      json.Object(fields) ->
        field(fields, key)
        |> result.map(fn(value) {
          case value {
            json.String(text) -> text
            _ -> ""
          }
        })
        |> result.unwrap("")
      _ -> ""
    }
  }
  snapshot.Expected(get("session_id"), get("epoch"), get("incarnation"))
}
